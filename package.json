{
  "name": "capture-mcp-server",
  "version": "4.0.2",
  "description": "AI-native Model Context Protocol server for SAM.gov, USASpending.gov, and Tango federal procurement data.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:web",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "capture-fixtures": "tsx scripts/capture-fixtures.ts",
    "release-version": "tsx scripts/release-version.ts",
    "smoke": "tsx scripts/smoke.ts",
    "docs:reference": "tsx scripts/gen-tool-reference.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p web/e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm build && tsx --test \"src/**/*.test.ts\"",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite build --watch --config web/vite.config.ts",
    "test:web": "pnpm build:web && pnpm --dir site build && playwright test",
    "kit:check": "node scripts/portal-kit.mjs",
    "kit:update": "node scripts/portal-kit.mjs --update",
    "package": "pnpm build && pnpm install --prod --frozen-lockfile && zip -r capture-mcp-server.mcpb dist/ node_modules/ manifest.json icon.png && pnpm install --frozen-lockfile",
    "package:dxt": "pnpm build && zip -r capture-mcp-server.dxt dist/ manifest.json icon.png"
  },
  "keywords": [
    "mcp",
    "federal",
    "procurement",
    "sam.gov",
    "usaspending",
    "tango"
  ],
  "author": "Mike Endale from BLEN, Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/blencorp/capture-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/blencorp/capture-mcp-server/issues"
  },
  "homepage": "https://github.com/blencorp/capture-mcp-server#readme",
  "engines": {
    "node": "^24.11.0 || ^26.0.0"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "axios": "^1.13.0",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "railway": "3.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.2",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8"
  },
  "packageManager": "pnpm@12.21.0"
}
