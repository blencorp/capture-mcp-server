{
  // Checking configuration (pnpm typecheck, the editor, typescript-eslint): sources, tests and
  // scripts. It never emits; tsconfig.build.json compiles src/ to dist/ without the tests.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "types": ["node"],
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", ".railway/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
