# Every setting the server reads. Copy to .env and uncomment what you need.

# --- Provider keys -------------------------------------------------------------------------------
# Used only by stdio and by single-user HTTP (MCP_ALLOW_INSECURE_HTTP=true). Hosted HTTP never uses
# them for a caller. Each is optional: a source without a key has no tools. USAspending and the
# reference codes need no key.
# SAM.gov: the Public API Key in your account details, https://sam.gov/workspace/profile/account-details
# SAM_GOV_API_KEY=your-sam-gov-api-key-here
# Tango: https://tango.makegov.com/docs/
# TANGO_API_KEY=your-tango-api-key-here
# HigherGov: https://www.highergov.com/api-external/docs/
# HIGHERGOV_API_KEY=your-highergov-api-key-here

# --- Transport -----------------------------------------------------------------------------------
# stdio (default) or http.
# MCP_TRANSPORT=stdio
# HTTP listening port (default 3000) and address. Single-user HTTP binds 127.0.0.1 and refuses any
# other HOST. Leave HOST unset when hosting so that Node listens on IPv4 and IPv6.
# PORT=3000
# HOST=

# HTTP mode (MCP_TRANSPORT=http) refuses to start unless you choose ONE of:
#  (a) OAuth: MCP_REQUIRE_OAUTH=true with OAUTH_TOKEN_SECRET and MCP_PUBLIC_BASE_URL (all required)
# MCP_REQUIRE_OAUTH=true
# OAUTH_TOKEN_SECRET=generate-with-openssl-rand-base64-48
# The public https origin your clients use. PUBLIC_URL is accepted as an alias.
# MCP_PUBLIC_BASE_URL=https://your-domain
#     Rotation: put the retired secret(s), comma-separated (at most 3), here so existing tokens keep
#     working; leave it unset to revoke every token sealed with an old secret.
# OAUTH_TOKEN_SECRET_PREVIOUS=
#     Token lifetimes in seconds (defaults 3600 and 7776000; at most 86400 and 7776000).
# OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# OAUTH_REFRESH_TOKEN_TTL_SECONDS=7776000
#     /mcp request budget per client address (defaults 5 and 20). Behind a proxy, name the header it
#     overwrites with the client address (Railway: x-real-ip).
# MCP_IP_RPS=5
# MCP_IP_BURST=20
# MCP_CLIENT_IP_HEADER=x-real-ip
#  (b) single user on this machine only (loopback):
# MCP_ALLOW_INSECURE_HTTP=true

# --- Diagnostics ---------------------------------------------------------------------------------
# Any value logs which provider keys are set (never their values) to stderr at startup.
# DEBUG=1
# NODE_ENV=production (set by the Dockerfile) caches the landing and policy pages; unset, they are
# read from disk on every request.
